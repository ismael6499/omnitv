<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ai_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#55000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/ai_panel_drawer"
        android:layout_width="540dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#1B1D24"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Top Header Bar -->
        <LinearLayout
            android:id="@+id/container_ai_header_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✨ OmniTV AI"
                android:textColor="#8AB4F8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_ai_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/pill_youtube_tv"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="⏸️"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/btn_ai_chat_lang"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/pill_youtube_tv"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="@string/ai_lang_badge"
                android:textColor="#CCCCCC"
                android:textSize="12sp"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/btn_ai_mic"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/pill_youtube_tv"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="@string/ai_voice_btn"
                android:textColor="#8AB4F8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/btn_ai_reset"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/pill_youtube_tv"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="@string/ai_new_chat"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:focusable="true"
                android:clickable="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_ai_close"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/pill_youtube_tv"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:text="@string/ai_close"
                android:textColor="#DDDDDD"
                android:textSize="12sp"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <!-- Current Video Title -->
        <TextView
            android:id="@+id/text_ai_video_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ai_detecting_video"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <!-- Status & Model Badge -->
        <TextView
            android:id="@+id/text_ai_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ai_ready"
            android:textColor="#9AA0A6"
            android:textSize="12sp"
            android:layout_marginBottom="10dp" />

        <!-- Main Action Pills (Always on top for quick mode switching) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/container_action_pills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_pill_vision_scan"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/pill_youtube_tv"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:text="@string/ai_pill_analyze_screen"
                    android:textColor="#8AB4F8"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btn_pill_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/pill_youtube_tv"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:text="@string/ai_pill_summarize"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btn_pill_key_points"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/pill_youtube_tv"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:text="@string/ai_pill_key_points"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btn_pill_conclusions"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/pill_youtube_tv"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:text="@string/ai_pill_conclusions"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btn_pill_moments"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/pill_youtube_tv"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:gravity="center"
                    android:text="@string/ai_pill_key_moments"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Vision / Screen Analysis Subpanel (Toggled via btn_pill_vision_scan) -->
        <LinearLayout
            android:id="@+id/panel_ai_vision_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="12dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/txt_vision_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ai_pill_analyze_ai"
                    android:textColor="#8AB4F8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_vision_close"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/pill_youtube_tv"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:gravity="center"
                    android:text="@string/ai_close"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp"
                    android:focusable="true"
                    android:clickable="true" />
            </LinearLayout>

            <!-- Option 1: Translate Text with Lens + Target Language Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/btn_vision_opt_translate"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/pill_youtube_tv"
                    android:gravity="center_vertical|start"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/ai_pill_lens_text"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/btn_vision_target_lang"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/pill_youtube_tv"
                    android:layout_marginStart="6dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:gravity="center"
                    android:text="@string/ai_lens_target"
                    android:textColor="#81D4FA"
                    android:textSize="12sp"
                    android:focusable="true"
                    android:clickable="true" />
            </LinearLayout>

            <!-- Option 2: Analyze Objects -->
            <TextView
                android:id="@+id/btn_vision_opt_objects"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/pill_youtube_tv"
                android:gravity="center_vertical|start"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/ai_pill_lens_objects"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"
                android:focusable="true"
                android:clickable="true" />

            <!-- Option 3: Places or People -->
            <TextView
                android:id="@+id/btn_vision_opt_places"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/pill_youtube_tv"
                android:gravity="center_vertical|start"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/ai_pill_lens_places"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <!-- Main Content Area: ScrollView with Chips and Follow-up Questions -->
        <ScrollView
            android:id="@+id/scroll_ai_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Loading State -->
                <LinearLayout
                    android:id="@+id/layout_ai_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:indeterminate="true"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/text_ai_loading_msg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_consulting"
                        android:textColor="#8AB4F8"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Initial Welcome / Fallback Card -->
                <TextView
                    android:id="@+id/text_ai_welcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_empty_state"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:background="@drawable/card_chip_content"
                    android:padding="14dp"
                    android:layout_marginBottom="8dp" />

                <!-- Container for Interactive Content Chips -->
                <LinearLayout
                    android:id="@+id/container_ai_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Separated Follow-up Questions Section (Appears below chips) -->
                <LinearLayout
                    android:id="@+id/layout_suggested_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp">

                    <!-- Visual Separator Line -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#353A47"
                        android:layout_marginBottom="12dp" />

                    <!-- Suggested Questions Header -->
                    <TextView
                        android:id="@+id/label_suggested_questions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_suggested_questions_title"
                        android:textColor="#8AB4F8"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <!-- Suggested Question Pills Container -->
                    <LinearLayout
                        android:id="@+id/container_suggested_questions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/btn_suggested_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="40dp"
                            android:background="@drawable/pill_youtube_tv"
                            android:gravity="center_vertical|start"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="@string/ai_q1"
                            android:textColor="#EEEEEE"
                            android:textSize="13sp"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/btn_suggested_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="40dp"
                            android:background="@drawable/pill_youtube_tv"
                            android:gravity="center_vertical|start"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="@string/ai_q2"
                            android:textColor="#EEEEEE"
                            android:textSize="13sp"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/btn_suggested_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="40dp"
                            android:background="@drawable/pill_youtube_tv"
                            android:gravity="center_vertical|start"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="@string/ai_q3"
                            android:textColor="#EEEEEE"
                            android:textSize="13sp"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_marginBottom="8dp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Footer Navigation Hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/ai_footer_nav"
            android:textColor="#666666"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Internal filter views to match system Dimmer and Blue Light from Frame 0 without flashes -->
    <View
        android:id="@+id/ai_menu_blue_light_filter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="98dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <View
        android:id="@+id/ai_menu_dimmer_filter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="99dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />
</FrameLayout>