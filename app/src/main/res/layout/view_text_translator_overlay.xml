<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tt_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:clickable="true"
    android:focusable="false">

    <LinearLayout
        android:id="@+id/tt_panel_drawer"
        android:layout_width="560dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#1B1D24"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:clickable="true"
        android:focusable="false">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tt_text_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tt_overlay_title"
                android:textColor="#8AB4F8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tt_btn_close"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/pill_youtube_tv"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:text="@string/ai_close"
                android:textColor="#DDDDDD"
                android:textSize="12sp"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <!-- Capture Source Pill Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tt_src_ui"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/pill_youtube_tv"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="@string/tt_src_ui"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/tt_src_ocr"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/pill_youtube_tv"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="@string/tt_src_ocr"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/tt_src_comments"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/pill_youtube_tv"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="@string/tt_src_comments"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/tt_src_lens"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/pill_youtube_tv"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="@string/tt_src_lens"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="6dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Engine, Language and Actions Pill Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="10dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tt_btn_engine"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/pill_youtube_tv"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="@string/tt_engine_standard"
                    android:textColor="#A5D6A7"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/tt_btn_lang"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/pill_youtube_tv"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="@string/comments_lang_es"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/tt_btn_translate_all"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/pill_youtube_tv"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="@string/comments_translate_all"
                    android:textColor="#81D4FA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/tt_btn_back_threads"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/pill_youtube_tv"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="@string/comments_back_to_threads"
                    android:textColor="#FFEB3B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Status / Counter Info -->
        <TextView
            android:id="@+id/tt_text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/comments_loading"
            android:textColor="#9AA0A6"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <!-- Scrollable List of Comments -->
        <ScrollView
            android:id="@+id/tt_scroll_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:scrollbars="vertical"
            android:focusable="false"
            android:descendantFocusability="afterDescendants">

            <LinearLayout
                android:id="@+id/tt_container_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Footer Navigation Hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/ai_footer_nav"
            android:textColor="#666666"
            android:textSize="11sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Internal filter views to match system Dimmer and Blue Light from Frame 0 without flashes -->
    <View
        android:id="@+id/tt_menu_blue_light_filter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="98dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <View
        android:id="@+id/tt_menu_dimmer_filter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="99dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />
</FrameLayout>
